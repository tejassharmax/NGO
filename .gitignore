# Dependencies
node_modules/

# Environment and secrets
.env
.env.*
!.env.example

# JSON at any level can be a credential (service account keys, OAuth client
# files), so only the package manifests are tracked.
*.json
!package.json
!package-lock.json

# Local data store and exports. These hold real child records; never commit them.
data/

# Images outside assets/ are local test files (report photos and the like).
*.png
*.jpg
*.jpeg
!assets/**
!google-logo.png

# Logs and local notes
*.log
_startup_log.txt
/*.txt

# Local working folders
scratch/
docs/
brag-output*/
github-profile/
orbit-original/
.agents/
DESIGN_SYSTEM.md

# OS and editors
Thumbs.db
.DS_Store
.vscode/
.idea/
