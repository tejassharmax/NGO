# ── Server ────────────────────────────────────────────────
# Render supplies PORT automatically; only set this for local runs.
PORT=3000

# Set to "production" on every server.
NODE_ENV=production

# LOCAL MACHINE ONLY: lets unauthenticated requests from this computer through
# (js/server/auth.js), so `npm start` works without signing in. Never set this
# on a hosted deployment.
# ALLOW_LOCAL_AUTH_BYPASS=true

# ── Firebase (authentication + database) ──────────────────
FIREBASE_PROJECT_ID=anirudh-449ca

# Firestore credential. Use exactly one:
#   Local  — save the key as serviceAccountKey.json in the project root (gitignored,
#            found automatically; no variable needed).
#   Render — paste the entire key JSON on ONE line into FIREBASE_SERVICE_ACCOUNT.
#            Without this the server falls back to data/db.json on an ephemeral
#            disk and every deploy loses all data.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"anirudh-449ca",...}

# NGO assigned to an allowlisted account whose Firestore record has no `ngo` field.
DEFAULT_NGO=Ayusha Nilayam

# ── Access control ────────────────────────────────────────
# Server-side allowlist, independent of Firestore so a compromised database
# cannot by itself grant API access.
AUTHORIZED_EMAILS=tejassachin2010@gmail.com,sachinsharma.hr@gmail.com,ayushahome@gmail.com

# Account the loopback bypass assumes during local development. Ignored in production.
LOCAL_DEV_EMAIL=tejassachin2010@gmail.com

# Your public site address(es), comma-separated.
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Google Workspace OAuth (Sheets & Docs sync) ───────────
# The redirect URI must be listed verbatim under "Authorized redirect URIs" on the
# OAuth client in Google Cloud Console. On a server set it to your public address.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback
