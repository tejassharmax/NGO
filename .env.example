# Copy to .env and fill in. Never commit .env.

# ── Server ────────────────────────────────────────────────
# Most hosts supply PORT themselves; set it for local runs.
PORT=3000

# "production" on every hosted server.
NODE_ENV=production

# LOCAL MACHINE ONLY: lets unauthenticated requests from this computer through
# (js/server/auth.js), so `npm start` works without signing in. Never set this
# on a hosted deployment.
# ALLOW_LOCAL_AUTH_BYPASS=true

# ── Firebase (authentication + database) ──────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore credential. Use exactly one:
#   - save the service account key as serviceAccountKey.json next to server.js
#     (gitignored, found automatically), or
#   - paste the whole key JSON on ONE line into FIREBASE_SERVICE_ACCOUNT.
# Without a credential the server falls back to data/db.json, which is only
# suitable for local development.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Space assigned to an allowlisted account whose Firestore record has no `ngo` field.
DEFAULT_NGO=Ayusha Nilayam

# ── Field encryption (Aadhaar and insurance IDs) ──────────
# 32 random bytes in base64. IDs are stored AES-256-GCM encrypted with this key;
# the server will not start in production without it. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy offline: if this key is lost, the stored IDs cannot be recovered.
FIELD_ENCRYPTION_KEY=

# ── Access control ────────────────────────────────────────
# Server-side allowlist, independent of Firestore so a compromised database
# cannot by itself grant API access.
AUTHORIZED_EMAILS=admin@example.org,staff@example.org

# Account the local bypass signs in as during development. Ignored in production.
LOCAL_DEV_EMAIL=admin@example.org

# Your public site address(es), comma-separated.
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Google Workspace OAuth (Sheets and Drive) ─────────────
# The redirect URI must be listed verbatim under "Authorized redirect URIs" on the
# OAuth client in Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/auth/google/callback

# The only Google account allowed to connect the main home; every sheet and
# Drive folder is created in its Drive.
GOOGLE_DRIVE_OWNER_EMAIL=owner@example.org
# Comma-separated accounts given editor access to those files.
GOOGLE_DRIVE_EDITOR_EMAILS=staff@example.org
