{
  "name": "ayusha-health",
  "version": "3.0.0",
  "description": "Health records for children in care, with Google Sheets and Drive sync and lab report reading",
  "private": true,
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.js",
    "start:prod": "npm install --omit=dev --no-audit --no-fund && node server.js",
    "setup:firestore": "node scripts/setupFirestore.js",
    "setup:firestore:dry": "node scripts/setupFirestore.js --dry-run",
    "test": "node scripts/test-blood-parser.mjs && node scripts/test-blood-parser-more.mjs && node scripts/test-record-validation.mjs && node scripts/test-sheet-insurance.mjs && node scripts/test-field-crypto.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.3",
    "firebase-admin": "^14.3.0",
    "googleapis": "^173.0.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "firebase": "^12.16.0",
    "pdfjs-dist": "^6.4.299",
    "rollup": "^4.62.4",
    "tesseract.js": "^7.0.0"
  }
}
